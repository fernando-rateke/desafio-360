{
  "name": "desafio-360",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Plataforma de quiz em revezamento para a roleta trigonométrica Desafio 360",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
